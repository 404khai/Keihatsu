// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String  @id @default(uuid())
  googleId         String? @unique
  email            String  @unique
  password         String? // Hashed password for email/password login
  avatarUrl        String?
  avatarHue        Float?
  avatarShape      Float?
  avatarExpression String  @default("happy")
  avatarAnimated   Boolean @default(false)
  username         String  @unique
  bio              String?
  bannerUrl        String?

  // Username update tracking
  usernameUpdatedAt   DateTime?
  usernameUpdateCount Int       @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lastLoginAt DateTime @default(now())

  isOnboarded     Boolean @default(false)
  isProfilePublic Boolean @default(true)

  // Preferences
  preferences Json? // Stores UI preferences like display style, filtering, etc.

  // Future ready fields
  readingStats     Json? // Storing reading stats as JSON for flexibility
  achievementCount Int   @default(0)
  points           Int   @default(0)
  role             Role  @default(USER)

  // Relations
  comments               Comment[]
  library                LibraryEntry[]
  categories             Category[]
  history                HistoryEntry[]
  historySyncEvents      HistorySyncEvent[]
  commentLikes           CommentLike[]
  notifications          Notification[]
  pushDevices            PushDevice[]
  notificationPreference NotificationPreference?

  @@map("users")
}

enum Role {
  USER
  ADMIN
}

model LibraryEntry {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Manga Data (Snapshot from source)
  mangaId      String // External Manga ID
  sourceId     String // ID of the source (e.g., 'mangadex', 'manhuatop')
  title        String
  thumbnailUrl String?
  author       String?
  language     String? // e.g., "EN"

  // Status & Counts
  unreadCount     Int @default(0)
  downloadedCount Int @default(0)
  totalChapters   Int @default(0)

  // Flags
  isUnread     Boolean @default(false)
  isStarted    Boolean @default(false)
  isBookmarked Boolean @default(true) // Usually added to library means bookmarked
  isCompleted  Boolean @default(false)

  // Timestamps for sorting
  lastReadAt    DateTime?
  lastUpdatedAt DateTime?
  dateAddedAt   DateTime  @default(now())

  // Relations
  categories Category[]

  @@unique([userId, sourceId, mangaId]) // Prevent duplicate entries for the same source manga
  @@map("library_entries")
}

model Category {
  id     String @id @default(uuid())
  name   String
  userId String
  user   User   @relation(fields: [userId], references: [id])

  entries LibraryEntry[]

  @@unique([userId, name]) // Unique category names per user
  @@map("categories")
}

model Comment {
  id      String   @id @default(uuid())
  content String
  images  String[] // Array of image URLs

  userId String
  user   User   @relation(fields: [userId], references: [id])

  mangaId   String // External Manga ID
  sourceId  String @default("manhuatop")
  chapterId String // External Chapter ID

  parentId String? // For nested comments
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies  Comment[] @relation("CommentReplies")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Likes
  likes     Int           @default(0)
  userLikes CommentLike[]

  @@index([sourceId, mangaId, chapterId])
  @@map("comments")
}

model CommentLike {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  commentId String
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
  @@map("comment_likes")
}

enum NotificationType {
  CHAPTER_UPDATE
  COMMENT_REPLY
  COMMENT_MENTION
  COMMENT_LIKE
  COMMENT_MODERATION
  SYSTEM_ANNOUNCEMENT
  SOURCE_OUTAGE
  SOURCE_RESTORED
  APP_UPDATE_REQUIRED
  ACCOUNT_SECURITY
  SYNC_FAILURE
}

enum PushPlatform {
  IOS
  ANDROID
}

model Notification {
  id          String           @id @default(uuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        NotificationType
  title       String
  body        String
  actorUserId String?
  sourceId    String?
  mangaId     String?
  chapterId   String?
  commentId   String?
  threadId    String?
  deepLink    String
  data        Json             @default("{}")
  groupingKey String?
  dedupeKey   String?
  readAt      DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  expiresAt   DateTime?

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt, id])
  @@index([userId, readAt, createdAt])
  @@index([userId, type, createdAt])
  @@map("notifications")
}

model PushDevice {
  id             String         @id @default(uuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform       PushPlatform
  token          String         @unique
  installationId String         @unique
  appVersion     String
  enabled        Boolean        @default(true)
  lastSeenAt     DateTime       @default(now())
  invalidatedAt  DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deliveries     PushDelivery[]

  @@index([userId, enabled])
  @@map("push_devices")
}

model PushDelivery {
  id             String     @id @default(uuid())
  notificationId String
  deviceId       String
  device         PushDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  status         String     @default("PENDING")
  attempts       Int        @default(0)
  nextAttemptAt  DateTime   @default(now())
  deliveredAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([notificationId, deviceId])
  @@index([status, nextAttemptAt])
  @@map("push_deliveries")
}

model NotificationPreference {
  userId               String   @id
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  libraryUpdates       Boolean  @default(true)
  commentReplies       Boolean  @default(true)
  commentMentions      Boolean  @default(true)
  commentLikes         Boolean  @default(false)
  moderation           Boolean  @default(true)
  sourceStatus         Boolean  @default(true)
  productAnnouncements Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("notification_preferences")
}

model ChapterSnapshot {
  id            String   @id @default(uuid())
  sourceId      String
  mangaId       String
  chapterIds    Json
  lastSuccessAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([sourceId, mangaId])
  @@map("chapter_snapshots")
}

model SystemAnnouncement {
  id            String        @id @default(uuid())
  title         String
  body          String
  platform      PushPlatform?
  minAppVersion String?
  maxAppVersion String?
  deepLink      String?
  severity      String
  pushEnabled   Boolean       @default(true)
  publishAt     DateTime
  expiresAt     DateTime?
  publishedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([publishAt, publishedAt])
  @@map("system_announcements")
}

model SourceHealth {
  sourceId          String    @id
  failureCount      Int       @default(0)
  lastSuccessAt     DateTime?
  lastFailureAt     DateTime?
  outageAnnouncedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("source_health")
}

model HistoryEntry {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  mangaId   String
  sourceId  String
  chapterId String

  // Durable source snapshots allow restoration without requiring a library row.
  title         String?
  thumbnailUrl  String?
  author        String?
  chapterName   String?
  chapterNumber Float?

  pageNumber Int      @default(0)
  lastReadAt DateTime @default(now())

  isBookmarked Boolean   @default(false)
  isRead       Boolean   @default(false)
  deletedAt    DateTime?

  @@unique([userId, sourceId, mangaId, chapterId]) // One entry per source chapter per user
  @@index([userId, deletedAt, lastReadAt])
  @@map("history_entries")
}

model HistorySyncEvent {
  id          String   @id @default(uuid())
  operationId String
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([userId, operationId])
  @@index([createdAt])
  @@map("history_sync_events")
}
