API_DOMAIN=api.keihatsu.app
# Generate URL-safe secrets, e.g. openssl rand -hex 32. Never commit .env.
POSTGRES_PASSWORD=
JWT_SECRET=
SWAGGER_ENABLED=false
CORS_ORIGINS=https://keihatsu.app,https://www.keihatsu.app
GOOGLE_CLIENT_ID_WEB=
GOOGLE_CLIENT_ID_ANDROID=
GOOGLE_CLIENT_ID_IOS=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
PUSH_PROVIDER=noop
CHAPTER_CHECK_INTERVAL_MS=3600000
CHAPTER_CHECK_CONCURRENCY=2
# Optional: place Firebase/APNs credentials in ./secrets and use container paths.
# GOOGLE_APPLICATION_CREDENTIALS=/run/keihatsu-secrets/firebase.json
# FCM_PROJECT_ID=
# APNS_PRIVATE_KEY_PATH=/run/keihatsu-secrets/apns.p8
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_BUNDLE_ID=
# APNS_ENV=production
